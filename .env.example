# Copy this file to .env, then fill in your values.
# Never commit the populated .env file.
# OpenAI-compatible providers use this key and endpoint pair.
ASK_AI_LLM_API_KEY=
ASK_AI_MODEL=qwen3.8-flash
ASK_AI_LLM_ENDPOINT=https://opencode.ai/inference/go/openai/v1/chat/completions
ASK_AI_SESSION_ID=ask-ai-local

# OPENAI_API_KEY is also accepted as a compatibility fallback.
OPENAI_API_KEY=
ASK_AI_INPUT_COST_PER_1M=
ASK_AI_OUTPUT_COST_PER_1M=

# Optional:
# PORT=8787
# ASK_AI_NOW=2026-01-01T00:00:00.000Z
