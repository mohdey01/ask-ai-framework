{
  "name": "highlevel-ask-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --env-file=.env --import=tsx backend/src/server.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file=.env --import=tsx backend/src/server.ts",
    "test": "node --env-file=.env --import=tsx tests/run.ts",
    "evaluate": "node --env-file=.env --import=tsx evaluation/run.ts",
    "benchmark:provider": "node --env-file=.env --import=tsx evaluation/provider_benchmark.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "vue": "^3.5.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
